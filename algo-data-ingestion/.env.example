# Copy to .env and fill with deployment-specific secrets.
# Never commit real API keys, admin tokens, Redis passwords, HMAC keys, or exchange keys.

# Twitter API credentials
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER=

# Reddit API credentials
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=algo-data-ingestion/0.1

# Data lake settings
DATA_LAKE_PATH=data_lake
MARKET_PATH=data_lake/market
ONCHAIN_PATH=data_lake/onchain
SOCIAL_PATH=data_lake/social
NEWS_PATH=data_lake/news

# Provider API credentials
NEWS_API_KEY=
GLASSNODE_API_KEY=
COVALENT_API_KEY=

# FastAPI service settings
INGEST_HOST=0.0.0.0
INGEST_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
METRICS_PATH=/metrics
ADMIN_TOKEN=change-me

# Redis (required by docker-compose.yml)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# RSS SSRF guardrails
RSS_ALLOWED_HOSTS=
RSS_MAX_BYTES=2097152
RSS_MAX_REDIRECTS=3

# Scheduler/trading decision queue
DECISION_QUEUE_URL=redis://:change-me-redis-password@redis:6379/0
DECISION_QUEUE_KEY=trading:decisions
TRADING_DECISION_HMAC_SECRET=change-me-decision-hmac-secret
TRADING_REQUIRE_SIGNED_DECISIONS=true

# Trading service
TRADING_STATE_BACKEND=file
TRADING_STATE_REDIS_URL=redis://:change-me-redis-password@redis:6379/0
TRADING_STATE_REDIS_HASH=trading:positions
TRADING_AUDIT_BACKEND=file
TRADING_AUDIT_REDIS_URL=redis://:change-me-redis-password@redis:6379/0
TRADING_AUDIT_STREAM=trading:audit
TRADING_AUDIT_MAXLEN=10000
TRADING_AUDIT_HMAC_KEY=change-me-audit-hmac-secret
TRADING_METRICS_PORT=9010
TRADING_DRY_RUN=true
TRADING_MODELS=[]

# Exchange credentials; use trade-only keys with withdrawals disabled.
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX_MODE=1

# Background jobs
BACKFILL_ENABLED=false
BACKFILL_EXCHANGE=binance
BACKFILL_SYMBOLS=BTC/USDT
BACKFILL_TIMEFRAMES=1m
BACKFILL_LOOKBACK_MIN=120
BACKFILL_INTERVAL_SEC=300
TTL_SWEEP_ENABLED=false
TTL_SWEEP_INTERVAL_SEC=600
