# Copy to .env and fill with deployment-specific secrets.
# Never commit real API keys, admin tokens, Redis passwords, HMAC keys, or exchange keys.

# Twitter API credentials
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER=

# Reddit API credentials
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=algo-data-ingestion/0.1

# Data lake settings
DATA_LAKE_PATH=data_lake
MARKET_PATH=data_lake/market
ONCHAIN_PATH=data_lake/onchain
SOCIAL_PATH=data_lake/social
NEWS_PATH=data_lake/news

# Provider API credentials
NEWS_API_KEY=
GLASSNODE_API_KEY=
COVALENT_API_KEY=

# FastAPI service settings
INGEST_HOST=0.0.0.0
INGEST_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
METRICS_PATH=/metrics
ADMIN_TOKEN=change-me

# Redis (required by docker-compose.yml)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# RSS SSRF guardrails
RSS_ALLOWED_HOSTS=
RSS_MAX_BYTES=2097152
RSS_MAX_REDIRECTS=3

# Scheduler/trading decision queue
DECISION_QUEUE_URL=redis://:change-me-redis-password@redis:6379/0
DECISION_QUEUE_KEY=trading:decisions
TRADING_DECISION_HMAC_SECRET=change-me-decision-hmac-secret
TRADING_REQUIRE_SIGNED_DECISIONS=true

# Trading service
TRADING_STATE_BACKEND=file
TRADING_STATE_REDIS_URL=redis://:change-me-redis-password@redis:6379/0
TRADING_STATE_REDIS_HASH=trading:positions
TRADING_AUDIT_BACKEND=file
TRADING_AUDIT_REDIS_URL=redis://:change-me-redis-password@redis:6379/0
TRADING_AUDIT_STREAM=trading:audit
TRADING_AUDIT_MAXLEN=10000
TRADING_AUDIT_HMAC_KEY=change-me-audit-hmac-secret
TRADING_METRICS_PORT=9010
TRADING_DRY_RUN=true
TRADING_MODELS=[]

# Exchange credentials; use trade-only keys with withdrawals disabled.
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX_MODE=1

# Background jobs
BACKFILL_ENABLED=false
BACKFILL_EXCHANGE=binance
BACKFILL_SYMBOLS=BTC/USDT
BACKFILL_TIMEFRAMES=1m
BACKFILL_LOOKBACK_MIN=120
BACKFILL_INTERVAL_SEC=300

# TTL sweep loop (inside API)
TTL_SWEEP_ENABLED=0
TTL_SWEEP_INTERVAL_SEC=900

# Scheduler
API_BASE_URL=http://ingestion-api:8000
RUN_ON_START=1
SCHED_TZ=UTC
SCHED_METRICS_PORT=9002
MARKET_JOBS=[{"exchange":"binance","symbol":"BTC/USDT","timeframe":"1m","lookback_minutes":60,"cron":"*/5 * * * *"}]
MARKET_INGEST_JOBS=[
  {"exchange":"binance","symbol":"BTC/USDT","timeframe":"1m","limit":500,"cron":"*/10 * * * *"}
]
TTL_SWEEP_CRON=*/15 * * * *
TTL_SWEEP_PATTERN=features:market:*
TTL_SWEEP_TTL=3600

# External APIs (Phase 3)
GLASSNODE_API_KEY=
COVALENT_API_KEY=
NEWS_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER=

# Sentiment ML
ML_SENTIMENT_ENABLED=0
SENTIMENT_MODEL_ID=distilbert/distilbert-base-uncased-finetuned-sst-2-english
ML_MAX_WORKERS=4
HF_HOME=/app/.cache/huggingface
SOCIAL_SENTIMENT_ENRICH=0

# Cloud object storage via fsspec (Phase 3)
# Example for S3 (requires s3fs)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# DATA_LAKE_PATH=s3://my-bucket/algo-data-lake
# MARKET_PATH=s3://my-bucket/algo-data-lake/market
# ONCHAIN_PATH=s3://my-bucket/algo-data-lake/onchain
# SOCIAL_PATH=s3://my-bucket/algo-data-lake/social
# NEWS_PATH=s3://my-bucket/algo-data-lake/news
# Optional advanced storage options for fsspec (JSON)
# FSSPEC_STORAGE_OPTIONS={"client_kwargs": {"region_name": "us-east-1"}}

# Example for GCS (requires gcsfs)
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
# DATA_LAKE_PATH=gs://my-bucket/algo-data-lake
# MARKET_PATH=gs://my-bucket/algo-data-lake/market
# Shared HMAC secret used by the scheduler to sign trading decisions and by
# the trading worker to reject forged Redis queue messages. Generate a strong
# random value before enabling the compose stack or live trading.
TRADING_DECISION_HMAC_SECRET=
TTL_SWEEP_ENABLED=false
TTL_SWEEP_INTERVAL_SEC=600
